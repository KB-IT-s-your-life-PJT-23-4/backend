<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.project.admin.auth.mapper.AdminAuthMapper">

    <resultMap id="adminResultMap"
               type="com.example.project.user.domain.UserVO">
        <id property="userId" column="user_id"/>
        <result property="email" column="email"/>
        <result property="userName" column="user_name"/>
        <result property="role" column="role"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="adminRoleFilter">
        role IN
        <foreach collection="roles"
                 item="role"
                 open="("
                 separator=","
                 close=")">
            #{role}
        </foreach>
    </sql>

    <select id="getAdmins" resultMap="adminResultMap">
        SELECT
            user_id,
            email,
            user_name,
            role,
            created_at,
            updated_at
        FROM user
        WHERE
        <include refid="adminRoleFilter"/>
        ORDER BY created_at DESC, user_id DESC
        LIMIT #{size}
        OFFSET #{offset}
    </select>

    <select id="getAdminCounts" resultType="long">
        SELECT COUNT(*)
        FROM user
        WHERE
        <include refid="adminRoleFilter"/>
    </select>

    <select id="findByUserId" resultMap="adminResultMap">
        SELECT
            user_id,
            email,
            user_name,
            role,
            created_at,
            updated_at
        FROM user
        WHERE user_id = #{userId}
    </select>

    <update id="changeAuth">
        UPDATE user
        SET role = #{role}
        WHERE user_id = #{userId}
    </update>

    <delete id="deleteAdmin">
        DELETE FROM user
        WHERE user_id = #{userId}
          AND role IN ('ROOT', 'MIDDLE', 'DEFAULT')
    </delete>

</mapper>
