<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.project.admin.report.mapper.ReportMapper">
    <resultMap id="aiSafetyReportResultMap"
               type="com.example.project.consultation.domain.AiSafetyReportVO">

        <id property="aiSafetyReportId"
            column="ai_safety_report_id"/>

        <result property="reportKey"
                column="report_key"/>

        <result property="reportType"
                column="report_type"/>

        <result property="status"
                column="status"/>

        <result property="userId"
                column="user_id"/>

        <result property="triggerEventId"
                column="trigger_event_id"/>

        <result property="questionExcerpt"
                column="question_excerpt"/>

        <result property="occurrenceCount"
                column="occurrence_count"/>

        <result property="countWindowStartedAt"
                column="count_window_started_at"/>

        <result property="countWindowEndedAt"
                column="count_window_ended_at"/>

        <result property="assignedAdminId"
                column="assigned_admin_id"/>

        <result property="resolutionNote"
                column="resolution_note"/>

        <result property="reviewedAt"
                column="reviewed_at"/>

        <result property="createdAt"
                column="created_at"/>

        <result property="updatedAt"
                column="updated_at"/>

    </resultMap>

    <sql id="reportFilter">
        <where>
            <if test="status != null">
                status = #{status}
            </if>

            <if test="reportType != null">
                AND report_type = #{reportType}
            </if>
        </where>
    </sql>

    <select id="selectAiReportsPage"
            resultMap="aiSafetyReportResultMap">

        SELECT
        r.ai_safety_report_id,
        r.report_key,
        r.report_type,
        r.status,
        r.user_id,
        r.trigger_event_id,
        e.question_excerpt,
        r.occurrence_count,
        r.count_window_started_at,
        r.count_window_ended_at,
        r.assigned_admin_id,
        r.resolution_note,
        r.reviewed_at,
        r.created_at,
        r.updated_at
        FROM ai_safety_report r
        LEFT JOIN ai_consultation_event e
          ON e.ai_consultation_event_id = r.trigger_event_id

        <include refid="reportFilter"/>

        ORDER BY
        r.created_at DESC,
        r.ai_safety_report_id DESC

        LIMIT #{size}
        OFFSET #{offset}
    </select>

    <select id="countAiReports"
            resultType="long">

        SELECT COUNT(*)
        FROM ai_safety_report

        <include refid="reportFilter"/>
    </select>

    <update id="updateReport">
        UPDATE ai_safety_report
        SET status = #{status},
            assigned_admin_id = #{adminId},
            resolution_note = #{resolutionNote},
            reviewed_at = CASE
                WHEN #{status} IN ('RESOLVED', 'DISMISSED')
                    THEN CURRENT_TIMESTAMP(6)
                ELSE NULL
            END
        WHERE ai_safety_report_id = #{reportId}
    </update>
</mapper>
