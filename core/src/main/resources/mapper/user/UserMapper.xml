<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.project.user.mapper.UserMapper">

    <resultMap id="userResultMap"
               type="com.example.project.user.domain.UserVO">
        <id property="userId" column="user_id"/>
        <result property="emailEncrypted" column="email_encrypted"/>
        <result property="emailHmac" column="email_hmac"/>
        <result property="password" column="password"/>
        <result property="userNameEncrypted" column="user_name_encrypted"/>
        <result property="birthDate" column="birth_date"/>
        <result property="phoneEncrypted" column="phone_encrypted"/>
        <result property="phoneHmac" column="phone_hmac"/>
        <result property="role" column="role"/>
        <result property="accountStatus" column="account_status"/>
        <result property="blockedUntil" column="blocked_until"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="img" column="img"/>
    </resultMap>

    <sql id="userColumns">
        user_id,
        email_encrypted,
        email_hmac,
        password,
        user_name_encrypted,
        birth_date,
        phone_encrypted,
        phone_hmac,
        role,
        account_status,
        blocked_until,
        created_at,
        updated_at,
        img
    </sql>

    <select id="findById"
            parameterType="long"
            resultMap="userResultMap">
        SELECT
        <include refid="userColumns"/>
        FROM user
        WHERE user_id = #{userId}
    </select>

    <select id="findByEmail"
            parameterType="string"
            resultMap="userResultMap">
        SELECT
        <include refid="userColumns"/>
        FROM user
        WHERE email_hmac = #{email}
    </select>

    <insert id="insert"
            parameterType="com.example.project.user.domain.UserVO"
            useGeneratedKeys="true"
            keyProperty="userId">
        INSERT INTO user (
            email_encrypted,
            email_hmac,
            password,
            user_name_encrypted,
            birth_date,
            phone_encrypted,
            phone_hmac,
            img
        )
        VALUES (
            #{emailEncrypted},
            #{emailHmac},
            #{password},
            #{userNameEncrypted},
            #{birthDate},
            #{phoneEncrypted},
            #{phoneHmac},
            #{img}
        )
    </insert>

    <update id="update"
            parameterType="com.example.project.user.domain.UserVO">
        UPDATE user
        SET email_encrypted = #{emailEncrypted},
            email_hmac = #{emailHmac},
            user_name_encrypted = #{userNameEncrypted},
            birth_date = #{birthDate},
            phone_encrypted = #{phoneEncrypted},
            phone_hmac = #{phoneHmac},
            img = #{img},
            updated_at = CURRENT_TIMESTAMP
        WHERE user_id = #{userId}
    </update>

    <delete id="deleteById"
            parameterType="long">
        DELETE
        FROM user
        WHERE user_id = #{userId}
    </delete>

</mapper>
